{
  "expo": {
    "name": "企业微信",
    "slug": "xuan-mobile",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/wecom-icon.png",
    "splash": {
      "image": "./assets/wecom-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FAF8"
    },
    "extra": {
      "xuanServer": "http://118.89.198.109:11443",
      "xuanWebServer": "http://127.0.0.1:11443",
      "androidUpdateManifestUrl": "http://118.89.198.109:9080/data/client/android-latest.json",
      "showServerInput": false
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xxa.xuanim",
      "buildNumber": "1"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.xxa.xuanim",
      "versionCode": 9
    },
    "web": {
      "favicon": "./assets/wecom-favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许企业微信访问相册，以便选择并发送图片。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}

